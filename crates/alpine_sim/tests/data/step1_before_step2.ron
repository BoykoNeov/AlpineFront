    scenario: "step1",
    seed: 1916,
    terrain: 1591674885090484508,
    tuning_toml: "# Alpine Front tuning numbers.\r\n#\r\n# Plain values, safe to edit. The simulation and the scenario tests read them from here, so a change\r\n# shows up in the next test report. The locked test expectations are in docs/scenario-tests.md.\r\n\r\n[time]\r\n# Simulation updates per game second.\r\nticks_per_second = 10\r\n# Fastest game speed the player can choose. The speed pass measures the simulation at this speed.\r\nmax_speed = 64\r\n\r\n[threads]\r\n# Worker threads the simulation splits its work across.\r\nsimulation_threads = 8\r\n\r\n[walking]\r\n# Walking speed follows Tobler\'s hiking rule: on ground rising by `grade` (metres up per metre\r\n# along), speed = peak_kmh * exp(-steepness * |grade + offset|). Fastest on a gentle downhill.\r\ntobler_peak_kmh = 6.0\r\ntobler_steepness = 3.5\r\ntobler_offset = 0.05\r\n# Soldiers carry kit, so they walk at this fraction of Tobler\'s unladen speed.\r\nload_factor = 0.7\r\n# Ground steeper than this cannot be walked on (climbing comes later).\r\nsteepest_walkable_deg = 45.0\r\n\r\n[squad]\r\nmen_per_squad = 10\r\n# Spacing between men when the squad has arrived and stands in formation.\r\nformation_spacing_m = 2.5\r\n# A man counts as arrived when this close to his place in the formation.\r\narrival_radius_m = 0.3\r\n# How long a squad leader takes to work out a route after receiving an order. The route is\r\n# computed in the background meanwhile; at 64x, 4 s gives it about 60 ms of real time (decision 30).\r\norder_delay_s = 4.0\r\n\r\n[soldier]\r\n# Men try to keep at least this far from each other while moving.\r\npersonal_space_m = 1.0\r\n# Height of a standing man\'s eyes, and of the point an observer must see to spot him (his head).\r\neye_height_m = 1.6\r\nhead_height_m = 1.6\r\n\r\n[spotting]\r\n# Clear weather, daylight, naked eye: a man further away than this is not spotted even in plain view.\r\nspotting_range_m = 1500.0\r\n# Each man looks around once per this many seconds (spread across ticks).\r\nlook_interval_s = 1.0\r\n\r\n[line_of_sight]\r\n# Earth curvature hides distant ground; air bends light back down by this fraction (standard value).\r\nrefraction_coefficient = 0.13\r\nearth_radius_m = 6371000.0\r\n\r\n[scenario]\r\n# Step-1 scenario: Austro-Hungarian squads start near the summit, Italian squads on the slopes below.\r\naustrian_squads = 15\r\nitalian_squads = 5\r\n# Austrians start within this distance of the summit.\r\naustrian_start_radius_m = 400.0\r\n# Italians start, and patrol, between these distances from the summit on its southern side,\r\n# below this height.\r\nitalian_zone_min_m = 1000.0\r\nitalian_zone_max_m = 2600.0\r\nitalian_zone_max_height_m = 2000.0\r\n# An Italian squad waits this long (game minutes, chosen at random in the range) before moving on.\r\npatrol_pause_min_minutes = 2.0\r\npatrol_pause_max_minutes = 10.0\r\n",
    ticks: 9000,
